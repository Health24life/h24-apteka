# What the concern asks of the model it is included in: a slug column and a Ukrainian name.
interface _Sluggable
  def slug: () -> String?
  def slug=: (String value) -> void
  def name_uk: () -> String?
  def saved_change_to_slug: () -> Array[String?]?
end

module Catalog::Sluggable : ActiveRecord::Base, _Sluggable
  extend ActiveSupport::Concern

  FORMAT: Regexp
  MAX_LENGTH: Integer

  def self.included: (?Module? base) { () [self: singleton(ActiveRecord::Base)] -> void } -> void

  def seo_redirects: () -> Seo::Redirect::ActiveRecord_Associations_CollectionProxy
  def own_slug?: () -> bool

  private

  def reserved_slugs: () -> Array[String]
  def slug_is_not_reserved: () -> void

  def assign_slug: () -> void
  def slug_is_not_redirected_elsewhere: () -> void
  def redirect_previous_slug: () -> void
  def seo_page_type: () -> String
end
