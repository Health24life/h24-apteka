class Pillbox::PlanItem
  NAME_LENGTH: Integer
  DOSAGE_LENGTH: Integer
  EVERY_N: Range[Integer]
  WEEKDAYS: Range[Integer]
  TIME_FORMAT: Regexp
  MAX_TIMES: Integer
  COURSE_DAYS: Range[Integer]
  MAX_COURSE_END: Integer
  SCHEDULE_ATTRIBUTES: Array[String]
  PERIOD_ATTRIBUTES: Array[String]

  def discard: () -> bool
  def discard=: (untyped value) -> untyped
  def normalize!: () -> Pillbox::PlanItem
  def start!: (Date? date, ActiveSupport::TimeWithZone now) -> Pillbox::PlanItem
  def position_came_from_user?: () -> bool
end
