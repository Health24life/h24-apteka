class Seo::Override
  include Seo::PageHistory
  extend Seo::PageHistory::ClassMethods
  include Translatable
  extend Translatable::ClassMethods
  extend Mobility
  include Seo::SanitizedHtml
  extend Seo::SanitizedHtml::ClassMethods

  def self.sanitized_html_attributes: () -> Array[Symbol]
  def self.sanitized_html_attributes=: (Array[Symbol] value) -> Array[Symbol]

  TARGET_TYPES: Array[String]
  TEXTS: Array[Symbol]

  def title: () -> String?
  def description: () -> String?
  def h1: () -> String?
  def seo_text: () -> String?
end

# The translation row Mobility keeps the long text in; its changes show on the page.
class Seo::Override::Translation
  include Seo::PageHistory
  extend Seo::PageHistory::ClassMethods
end
