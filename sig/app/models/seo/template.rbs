class Seo::Template
  include Translatable
  extend Translatable::ClassMethods
  extend Mobility

  def title: () -> String?
  def description: () -> String?
  def h1: () -> String?

  PLACEHOLDER: Regexp
  PLACEHOLDERS: Hash[String, Array[String]]
  TEXTS: Array[Symbol]

  def general?: () -> bool
  def placeholders: () -> Array[String]

  private

  def recipe_only_for_goods: () -> void
  def placeholders_are_known: () -> void
  def keep_general: () -> void
end
