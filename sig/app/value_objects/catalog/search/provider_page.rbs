  attr_reader records: Array[Pharmapoint::json]

  def self.new: (provider: String, hits: Array[Catalog::Search::Hit], per_page: Integer, total_groups: Integer,
                 has_more: bool, records: Array[Pharmapoint::json]) -> instance
end
