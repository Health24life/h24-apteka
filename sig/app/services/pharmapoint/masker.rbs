class Pharmapoint::Masker
  # What a log entry may hold: the partner's JSON and the symbol keys of our own records.
  type tree = nil | bool | Integer | Float | String | Symbol | Array[tree] | Hash[String, tree] | Hash[Symbol, tree]

  MARKER: String

  @config: Pharmapoint::Config

  def initialize: (?config: Pharmapoint::Config) -> void
  def headers: (Hash[String | Symbol, String] raw) -> Hash[String, String]
  def body: (tree value) -> tree
  def text: (String value) -> String

  private

  def secret_header?: (String | Symbol name) -> bool
  def secret_key?: (String | Symbol key) -> bool
  def clean: (String string) -> String
end
