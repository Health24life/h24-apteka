class Pharmapoint::Transport
  type timeouts = Hash[Symbol, Integer | Float]
  type params = Hash[Symbol, String | Integer | Float]
  type body = Hash[Symbol, untyped]

  ERROR_BODY_LIMIT: Integer

  @config: Pharmapoint::Config
  @rate_limiter: Pharmapoint::RateLimiter
  @masker: Pharmapoint::Logging::Masker
  @logger: Pharmapoint::Logging::RequestLogger

  def initialize: (config: Pharmapoint::Config, rate_limiter: Pharmapoint::RateLimiter,
                   masker: Pharmapoint::Logging::Masker, logger: Pharmapoint::Logging::RequestLogger) -> void
  def call: [T] (String path, ?params params, ?body: body?, ?share: Symbol?, ?timeouts: timeouts?)
              { (Pharmapoint::json) -> T } -> T

  private

  def request: (String path, params params, body? body, [String, String] credentials, timeouts? timeouts)
             -> Faraday::Response
  def parse: (String? body) -> Pharmapoint::json
  def check_status!: (Faraday::Response response) -> void
  def rate_limited: (Faraday::Response response) -> Pharmapoint::RateLimited
  def connection: (String api_key, String domain_name, ?timeouts? timeouts) -> Faraday::Connection
end
