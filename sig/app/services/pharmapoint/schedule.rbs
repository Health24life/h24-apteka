class Pharmapoint::Schedule
  # One job as sidekiq-cron reads it: its cron, class and queue, and the arguments of the class.
  type entry = Hash[String, String | Array[String]]
  type jobs = Hash[String, entry]

  SOURCE: String
  SYNC_RUNS: Hash[String, [ String, String, String ]]
  LOG_CLEANUP: [ String, String ]

  @env: Pharmapoint::Config::_Env

  def self.jobs: (?Pharmapoint::Config::_Env env) -> Pharmapoint::Schedule::jobs

  def initialize: (Pharmapoint::Config::_Env env) -> void
  def jobs: () -> Pharmapoint::Schedule::jobs

  private

  def sync_jobs: () -> Pharmapoint::Schedule::jobs
  def cleanup_job: () -> Pharmapoint::Schedule::jobs
  def job: (String klass, String cron, ?args: Array[String]) -> Pharmapoint::Schedule::entry
  def cron: (String variable, String default) -> String?
end
