class Pharmapoint::Config
  include Dry::Configurable
  extend Dry::Configurable::ClassMethods

  interface _Connection
    def base_url: () -> String
    def api_key: () -> String?
    def domain_name: () -> String?
    def open_timeout: () -> Integer
    def read_timeout: () -> Integer
  end

  interface _RateLimit
    def per_minute: () -> Integer
    def window: () -> Integer
  end

  interface _Search
    def open_timeout: () -> Float
    def read_timeout: () -> Float
    def per_page: () -> Integer
    def rate_limit_per_minute: () -> Integer
  end

  interface _Cart
    def open_timeout: () -> Integer
    def read_timeout: () -> Integer
    def rate_limit_per_minute: () -> Integer
  end

  interface _LogRetentionDays
    def booking: () -> Integer
    def search: () -> Integer
    def refresh: () -> Integer
    def other: () -> Integer
    def to_h: () -> Hash[Symbol, Integer]
  end

  DEFAULT_BASE_URL: String
  SECRET_HEADERS: Array[String]
  SECRET_BODY_KEYS: Array[String]
  INTEGER: ^(untyped) -> Integer
  FLOAT: ^(untyped) -> Float
  PRESENT: ^(untyped) -> untyped

  def connection: () -> _Connection
  def rate_limit: () -> _RateLimit
  def goods_groups_per_page: () -> Integer
  def search: () -> _Search
  def cart: () -> _Cart
  def log_retention_days: () -> _LogRetentionDays
  def credentials!: () -> [ String, String ]
  def retention_for: (String | Symbol category) -> ActiveSupport::Duration
end
