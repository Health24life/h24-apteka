class Pharmapoint::Config
  interface _Env
    def fetch: (String key, untyped default) -> untyped
  end

  class Point < Data
    attr_reader latitude: Float
    attr_reader longitude: Float
    attr_reader radius: Integer

    def self.new: (latitude: Float, longitude: Float, radius: Integer) -> instance
  end

  DEFAULT_BASE_URL: String
  RETENTION_DAYS: Hash[String, Integer]
  DEFAULTS: Hash[Symbol, untyped]
  SECRET_HEADERS: Array[String]
  SECRET_BODY_KEYS: Array[String]

  @current: Pharmapoint::Config?
  @search_points: Array[Point]?

  attr_reader base_url: String
  attr_reader api_key: String?
  attr_reader domain_name: String?
  attr_reader rate_limit_per_minute: Integer
  attr_reader rate_limit_window: Integer
  attr_reader open_timeout: Integer
  attr_reader read_timeout: Integer
  attr_reader goods_groups_per_page: Integer
  def search_points: () -> Array[Point]
  attr_reader stale_run_after: ActiveSupport::Duration
  attr_reader stale_record_after: ActiveSupport::Duration
  attr_reader retention_days: Hash[String, Integer]

  def self.current: () -> Pharmapoint::Config
  def self.reset!: () -> nil
  def self.from_env: (?_Env env) -> Pharmapoint::Config
  def self.parse_points: (String? json) -> Array[Point]
  def self.parse_retention: (_Env env) -> Hash[String, Integer]

  def initialize: (?base_url: String, ?api_key: String?, ?domain_name: String?, ?rate_limit_per_minute: Integer,
                   ?rate_limit_window: Integer, ?open_timeout: Integer, ?read_timeout: Integer,
                   ?goods_groups_per_page: Integer, ?search_points: Array[Point],
                   ?stale_run_after: ActiveSupport::Duration, ?stale_record_after: ActiveSupport::Duration,
                   ?retention_days: Hash[String, Integer]) -> void
  def credentials!: () -> [ String, String ]
  def retention_for: (String | Symbol category) -> ActiveSupport::Duration
end
