class Pharmapoint::RequestLogger
  class Entry < Data
    attr_reader http_method: String
    attr_reader path: String
    attr_reader query: Hash[String, Pharmapoint::json]
    attr_reader request_headers: Pharmapoint::headers
    attr_reader request_body: Pharmapoint::json
    attr_reader response_status: Integer?
    attr_reader response_headers: Pharmapoint::headers
    attr_reader response_body: Pharmapoint::json
    attr_reader outcome: String
    attr_reader error_class: String?
    attr_reader duration_ms: Integer

    def self.new: (http_method: String, path: String, query: Hash[String, Pharmapoint::json],
                   request_headers: Pharmapoint::headers, request_body: Pharmapoint::json, response_status: Integer?,
                   response_headers: Pharmapoint::headers, response_body: Pharmapoint::json, outcome: String,
                   error_class: String?, duration_ms: Integer) -> instance
  end

  @provider: Provider
  @category: Symbol | String
  @user_id: Integer?
  @sync_run: SyncRun?
  @attempt: Integer
  @masker: Pharmapoint::Masker
  @last: ProviderRequestLog?

  def initialize: (provider: Provider, category: Symbol | String, user_id: Integer?, sync_run: SyncRun?,
                   attempt: Integer, ?masker: Pharmapoint::Masker) -> void
  def record: (Entry entry) -> void
  def mark_invalid_response!: () -> void

  private

  def context: () -> { provider: Provider, sync_run: SyncRun?, user_id: Integer?, category: String, attempt: Integer }
  def attributes_of: (Entry entry) -> { http_method: String, path: String, query: Pharmapoint::Masker::tree,
                                        request_headers: Pharmapoint::headers, request_body: Pharmapoint::Masker::tree,
                                        response_headers: Pharmapoint::headers, response_body: Pharmapoint::Masker::tree,
                                        response_status: Integer?, outcome: String, error_class: String?,
                                        duration_ms: Integer }
end
