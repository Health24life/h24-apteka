class Pharmapoint::Logging::Middleware < Faraday::Middleware
  interface _App
    def call: (Faraday::Env env) -> Faraday::Response
  end

  interface _Clock
    def clock_gettime: (Integer id) -> Float
  end

  class Result < Data
    attr_reader status: Integer?
    attr_reader headers: Pharmapoint::headers
    attr_reader body: Pharmapoint::json
    attr_reader outcome: String
    attr_reader error_class: String?

    def self.new: (status: Integer?, headers: Pharmapoint::headers, body: Pharmapoint::json, outcome: String,
                   error_class: String?) -> instance
  end

  @logger: Pharmapoint::Logging::RequestLogger
  @clock: _Clock

  def initialize: (_App app, logger: Pharmapoint::Logging::RequestLogger, ?clock: _Clock) -> void
  def call: (Faraday::Env env) -> Faraday::Response

  private

  def elapsed_ms: (Float started) -> Integer
  def entry: (Faraday::Env env, Faraday::Error? error, Integer duration) -> Pharmapoint::Logging::RequestLogger::Entry
  def request_part: (Faraday::Env env) -> { http_method: String, path: String, query: Hash[String, Pharmapoint::json],
                                           request_headers: Pharmapoint::headers, request_body: Pharmapoint::json }
  def response_part: (Result result) -> { response_status: Integer?, response_headers: Pharmapoint::headers,
                                           response_body: Pharmapoint::json, outcome: String, error_class: String? }
  def query_of: (Faraday::Env env) -> Hash[String, Pharmapoint::json]
  def failed: (Faraday::Error error) -> Result
  def answered: (Faraday::Env env) -> Result
  def outcome_of: (Integer status, Pharmapoint::json body) -> String
  def json_value: (Pharmapoint::json body) -> Pharmapoint::json
end
