class Pharmapoint::Client
  GOODS_GROUPS_PATH: String
  GOODS_GROUP_PATH: String
  DICTIONARIES_PATH: String
  CATEGORY_TREE_PATH: String
  DRUGSTORES_PATH: String
  DRUGSTORE_PATH: String
  OFFERS_NEARBY_PATH: String
  OFFERS_IN_DRUGSTORE_PATH: String
  STORE_PICK_UP_ORDER_PATH: String
  ORDER_PATH: String
  ORDER_HISTORY_PATH: String
  ORDER_HISTORY_PER_PAGE: Integer
  CANCEL_ORDER_PATH: String

  @config: Pharmapoint::Config
  @transport: Pharmapoint::Transport

  def initialize: (provider: Provider, ?config: Pharmapoint::Config, ?purpose: Symbol | String, ?user_id: Integer?,
                   ?sync_run: SyncRun?, ?attempt: Integer, ?rate_limiter: Pharmapoint::RateLimiter) -> void
  def dictionaries: () -> Pharmapoint::Dictionaries
  def category_tree: () -> Array[Pharmapoint::CategoryNode]
  def goods_groups: (page: Integer, ?per_page: Integer) -> Pharmapoint::Page
  def search_goods_groups: (query: String, page: Integer, location: Pharmapoint::SearchPoint, ?per_page: Integer,
                            ?read_timeout: (Integer | Float)?) -> [ Pharmapoint::Page, Array[Pharmapoint::json] ]
  def goods_group: (String external_id) -> Pharmapoint::GoodsGroup
  def drugstores: (Pharmapoint::SearchPoint point) -> Array[Pharmapoint::Drugstore]
  def drugstore: (String external_id) -> Pharmapoint::Drugstore
  def offers_nearby: (goods: Array[Pharmapoint::OrderLine], location: Pharmapoint::SearchPoint) -> Array[Pharmapoint::Offer]
  def offers_in_drugstore: (goods: Array[Pharmapoint::OrderLine], drugstore_external_id: String, ?share: Symbol?)
                         -> Array[Pharmapoint::Offer]
  def store_pick_up_order: (Pharmapoint::Transport::body body) -> Pharmapoint::PartnerOrder
  def order: (String number) -> Pharmapoint::PartnerOrder
  def order_history: (phone: String) -> Array[Pharmapoint::PartnerOrder]
  def cancel_order: (number: String, phone: String, reason: String) -> true

  private

  def offer_line: (Pharmapoint::OrderLine line) -> { goods_id: String, quantity: Integer }
  def deliver: [T] (String path, Pharmapoint::Transport::body body, Pharmapoint::Transport::params params, ?share: Symbol?)
                 { (Pharmapoint::json) -> T } -> T
  def ordering: [T] (String path, Pharmapoint::Transport::params params, ?body: Pharmapoint::Transport::body?,
                     ?headers: Pharmapoint::Transport::headers?) { (Pharmapoint::json) -> T } -> T
  def fetch: [T] (String path, ?Pharmapoint::Transport::params params, ?body: Pharmapoint::Transport::body?,
                  ?headers: Pharmapoint::Transport::headers?, ?share: Symbol?, ?timeouts: Pharmapoint::Transport::timeouts?)
               { (Pharmapoint::json) -> T } -> T
end
