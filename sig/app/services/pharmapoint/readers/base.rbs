module Pharmapoint::Readers::Base
  type record = Hash[String, Pharmapoint::json]

  def self?.envelope: (Pharmapoint::json body, ?String key) -> Pharmapoint::json
  def self?.hash_or_empty: (Pharmapoint::json value) -> record
  def self?.list: (Pharmapoint::json value) -> Array[Pharmapoint::json]
  def self?.text: (Pharmapoint::json value) -> String?
  def self?.external_id: (Pharmapoint::json value) -> String?
  def self?.integer: (Pharmapoint::json value) -> Integer?
  def self?.float: (Pharmapoint::json value) -> Float?
  def self?.affirmative?: (Pharmapoint::json value) -> bool
  def self?.images: (Pharmapoint::json value) -> Array[String]
  def self?.name: (record record) -> String?
  def self?.text_at: (record record, String key) -> String?
  def self?.id_at: (record record, String key) -> String?
  def self?.int_at: (record record, String key) -> Integer?
  def self?.float_at: (record record, String key) -> Float?
  def self?.affirmative_at?: (record record, String key) -> bool
  def self?.images_at: (record record, String key) -> Array[String]
  def self?.list_at: (record record, String key) -> Array[Pharmapoint::json]
  def self?.hash_at: (record record, String key) -> record
end
