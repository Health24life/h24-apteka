  REFERENCE_FIELDS: Hash[Symbol, Pharmapoint::Readers::Base::field]
  PACK_FIELDS: Hash[Symbol, Pharmapoint::Readers::Base::field]

  def self.page: (Pharmapoint::json body, page: Integer, per_page: Integer) -> Pharmapoint::Page
  def self.one: (Pharmapoint::json body) -> Pharmapoint::record

  def page: (Pharmapoint::json body, page: Integer, per_page: Integer) -> Pharmapoint::Page
  def one: (Pharmapoint::json body) -> Pharmapoint::record

  private

  def base: () -> singleton(Pharmapoint::Readers::Base)
  def group: (Pharmapoint::json record) -> Pharmapoint::record?
  def links: (Hash[String, Pharmapoint::json] record) -> Pharmapoint::record
  def producer: (Pharmapoint::json record) -> Pharmapoint::record?
  def goods_name: (Pharmapoint::json record) -> Pharmapoint::record?
  def atc_class: (Pharmapoint::json record, Pharmapoint::json ancestors) -> Pharmapoint::record?
  def atc_entry: (Pharmapoint::json record) -> Pharmapoint::record?
  def categories: (Hash[String, Pharmapoint::json] record) -> Array[Pharmapoint::record]
  def category_path: (Array[Pharmapoint::json] paths, Integer? index) -> Array[Pharmapoint::record]
  def category_node: (Pharmapoint::json record) -> Pharmapoint::record?
  def goods: (Pharmapoint::json record) -> Pharmapoint::record?
  def card: (Hash[String, Pharmapoint::json] record) -> Pharmapoint::record
  def morion_code: (Hash[String, Pharmapoint::json] record) -> String?
end
