  def category_node: (untyped record) -> Pharmapoint::record?
  def goods: (untyped record) -> Pharmapoint::record?
  def card: (Hash[String, untyped] record) -> Pharmapoint::record
  def morion_code: (Hash[String, untyped] record) -> String?
