class Catalog::Sync::Pull
  type kind = :goods_group | :drugstore

  type type_config = { model: singleton(Catalog::Goods::Group) | singleton(Catalog::Drugstore), kind: String }

  type outcome = :enqueued | :queued_already | :present | :hidden | :cooling_down | :wanted

  class Found < Data
    attr_reader external_id: String
    attr_reader goods_ids: Array[String]
    attr_reader record: Pharmapoint::Readers::Base::record

    def self.new: (external_id: String, goods_ids: Array[String], record: Pharmapoint::Readers::Base::record) -> instance
  end

  class Known < Data
    attr_reader synced_at: ActiveSupport::TimeWithZone
    attr_reader withdrawn: bool
    attr_reader hidden: bool

    def self.new: (synced_at: ActiveSupport::TimeWithZone, withdrawn: bool, hidden: bool) -> instance
  end

  TYPES: Hash[Symbol, type_config]
  COOLDOWN_PREFIX: String

  def self.enqueue: (kind type, String | Integer external_id, ?user_id: Integer?, ?provider: Provider?,
                     ?config: Pharmapoint::Config) -> (:enqueued | :queued_already | :present)
  def self.enqueue_found: (provider: Provider, found: Array[Pharmapoint::json], ?user_id: Integer?,
                           ?config: Pharmapoint::Config) -> Hash[String, outcome]
  def self.queue_found: (Provider provider, Array[Found] groups, Integer? user_id, Pharmapoint::Config config) -> Hash[String, outcome]
  def self.report: (Exception error) -> Hash[String, outcome]
  def self.current?: (Known known, Pharmapoint::Config config) -> bool
  def self.read_found: (Pharmapoint::json record) -> Found?
  def self.decide: (Provider provider, Array[Found] groups, Pharmapoint::Config config) -> Hash[String, outcome]
  def self.decision: (Found group, Known? known, Set[String] linked_goods, Set[String] cooling,
                      Pharmapoint::Config config) -> outcome
  def self.known_groups: (Provider provider, Array[String] ids) -> Hash[String, Known]
  def self.linked_goods: (Provider provider, Array[String] ids) -> Set[String]
  def self.cool_down!: (Integer provider_id, kind | String type, String external_id, ?config: Pharmapoint::Config) -> void
  def self.cooling_down: (Provider provider, kind type, Array[String] ids) -> Set[String]
  def self.cooldown_key: (Integer provider_id, kind | String type, String external_id) -> String
  def self.present?: (kind type, String | Integer external_id, Pharmapoint::Config config, ?Provider provider) -> bool
  def self.linked: (kind type, String | Integer external_id, ?Provider provider) -> Provider::Link?
end
