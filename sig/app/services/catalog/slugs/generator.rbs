class Catalog::Slugs::Generator
  interface _SlugScope
    def where: (Hash[Symbol, Array[String]] conditions) -> _SlugRelation
    def polymorphic_name: () -> String
  end

  interface _SlugRelation
    def pluck: (Symbol column) -> Array[String]
  end

  FALLBACK: String
  BATCH: Integer
  NON_KMU_LETTERS: String
  KMU_LETTERS: String

  @scope: _SlugScope
  @reserved: Set[String]

  def self.call: (String? text, scope: _SlugScope, ?reserved: Set[String]) -> String

  def initialize: (_SlugScope scope, ?reserved: Set[String]) -> void
  def call: (String? text) -> String

  private

  def redirected: (Array[String] candidates) -> Array[String]
  def transliterate: (String? text) -> String
  def with_suffix: (String base, String suffix) -> String
end
