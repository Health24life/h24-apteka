class Orders::Offers::Nearby
  SORTS: Array[String]

  class Row < Data
    attr_reader drugstore: Catalog::Drugstore
    attr_reader offer: Orders::Offers::DrugstoreOffer
    attr_reader line: Orders::Offers::Line
    attr_reader opens_at: String?

    def self.new: (drugstore: Catalog::Drugstore, offer: Orders::Offers::DrugstoreOffer, line: Orders::Offers::Line,
                   opens_at: String?) -> instance

    def id: () -> Integer
    def name: () -> String?
    def brand: () -> Catalog::Drugstore::Brand?
    def address: () -> Catalog::Drugstore::Address?
    def drugstore_legal_entity_name: () -> String
    def drugstore_legal_entity_code: () -> String
    def phone: () -> String?
    def mobile_phone: () -> String?
    def week_working_hours: () -> Array[String?]
    def work_with_reimbursement: () -> bool
    def distance: () -> Integer?
    def open_now: () -> bool?
    def price: () -> BigDecimal?
    def available_quantity: () -> Integer
  end

  @goods: Catalog::Goods
  @location: Orders::Offers::Adapters::_Location
  @sort: String
  @reimbursement: bool
  @user_id: Integer?

  def self.find_goods: (untyped id) -> Catalog::Goods?
  def self.call: (Catalog::Goods goods, location: Orders::Offers::Adapters::_Location, ?sort: String,
                  ?reimbursement: bool, ?user_id: Integer?) -> (Array[Row] | Orders::Offers::Failure)

  def initialize: (Catalog::Goods goods, location: Orders::Offers::Adapters::_Location, sort: String,
                   reimbursement: bool, user_id: Integer?) -> void
  def call: () -> (Array[Row] | Orders::Offers::Failure)

  private

  def adapters: () -> Array[Orders::Offers::Adapters::_Adapter]
  def failure: (Array[Orders::Offers::Failure] failures) -> Orders::Offers::Failure
  def rows: (Array[Orders::Offers::DrugstoreOffer] offers) -> Array[Row]
  def priced?: (Orders::Offers::DrugstoreOffer offer) -> bool
  def row: (Orders::Offers::DrugstoreOffer offer, Hash[Integer, Catalog::Drugstore] drugstores) -> Row?
  def shown_drugstores: (Array[Integer] ids) -> Hash[Integer, Catalog::Drugstore]
  def sorted: (Array[Row] rows) -> Array[Row]
end
