class Orders::Bookings::Book
  class Result < Data
    attr_reader order: Order
    attr_reader submitted: bool

    def self.new: (order: Order, submitted: bool) -> instance
  end

  LEASE_SECONDS: Integer

  @owner: Orders::Carts::Owner
  @request: Orders::Bookings::Request

  def self.call: (Orders::Carts::Owner owner, Orders::Bookings::Request request) -> Result

  def initialize: (Orders::Carts::Owner owner, Orders::Bookings::Request request) -> void
  def call: () -> Result

  private

  def book: () -> Result
  def prepare: (Order order, Orders::Offers::DrugstoreOffer offer) -> void
  def bookable: () -> Order
  def confirmed: (Order order) -> Orders::Offers::DrugstoreOffer
  def live_offer: (Order order) -> (Orders::Offers::DrugstoreOffer | Orders::Offers::Failure | nil)
  def take_client: (Order order) -> void
  def sent_before: (Order order, String phone) -> Pharmapoint::PartnerOrder?
  def send_to_provider: (Order order) -> Result
  def accepted: (Order order, Pharmapoint::PartnerOrder partner_order) -> Result
  def partner_state: (Pharmapoint::PartnerOrder partner_order) -> Hash[Symbol, untyped]
  def keep: (Order order) -> void
  def adapter: (Order order) -> Orders::Bookings::Adapters::_Adapter
  def busy: (Integer? retry_after) -> bot
  def unavailable: () -> bot
  def refuse: (Symbol code, Symbol status) -> bot
end
