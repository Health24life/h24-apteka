class Seo::Sitemaps::Parts
  class Part < Data
    attr_reader name: String
    attr_reader changed_at: ActiveSupport::TimeWithZone?

    def self.new: (name: String, changed_at: ActiveSupport::TimeWithZone?) -> instance
  end

  LIMIT: Integer
  NAMESPACE: String

  @dir: Pathname
  @kind: String
  @limit: Integer
  @parts: Array[Part]
  @count: Integer
  @file: File?
  @name: String?
  @changed_at: ActiveSupport::TimeWithZone?

  def initialize: (Pathname dir, String kind, ?limit: Integer) -> void
  def add: (String url, ActiveSupport::TimeWithZone? changed_at) -> void
  def finish: () -> Array[Part]

  private

  def start_part: () -> void
  def close_part: () -> void
  def lastmod: (ActiveSupport::TimeWithZone? changed_at) -> String
end
