class Seo::Templates::Preview
  type record = Catalog::Goods | Catalog::Category | Seo::StaticPage

  class Text < Data
    attr_reader value: String
    attr_reader length: Integer
    attr_reader limit: Integer?

    def self.new: (value: String, length: Integer, limit: Integer?) -> instance
    def cut?: () -> bool
  end

  class Result < Data
    attr_reader title: Text
    attr_reader description: Text
    attr_reader h1: Text

    def self.new: (title: Text, description: Text, h1: Text) -> instance
    def cut?: () -> bool
  end

  MODELS: Hash[String, singleton(Catalog::Goods) | singleton(Catalog::Category) | singleton(Seo::StaticPage)]

  def self.call: (template: Seo::Template, record: record?) -> Result
  type records = Catalog::Goods::ActiveRecord_Relation | Catalog::Category::ActiveRecord_Relation
               | Catalog::Category::ActiveRecord_Associations_CollectionProxy | Seo::StaticPage::ActiveRecord_Relation

  def self.records: (Seo::Template template) -> records
  def self.options: (String page_type, untyped params) -> records
  def self.applies_to?: (Seo::Template template, record? record) -> bool

  private

  def self.goods: (Seo::Template template, untyped branch) -> Catalog::Goods::ActiveRecord_Relation
  def self.text: (String? text, Hash[String, String?] values, Integer? limit) -> Text
end
