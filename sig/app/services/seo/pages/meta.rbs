class Seo::Pages::Meta
  TITLE_LIMIT: Integer
  DESCRIPTION_LIMIT: Integer

  attr_reader title: String
  attr_reader description: String
  attr_reader h1: String
  attr_reader seo_text: String?

  @title: String
  @description: String
  @h1: String
  @seo_text: String?

  def self.call: (Seo::Pages::Resolve::Page page) -> Seo::Pages::Meta

  def self.values_for: (Seo::Pages::Resolve::record? record) -> Hash[String, String?]

  private

  def self.template_for: (Seo::Pages::Resolve::Page page) -> Seo::Template
  def self.by_hand: (Seo::Override? override, Symbol field) -> String?
  def self.generate: (Seo::Template template, Hash[String, String?] values, Integer page_number) -> [ String, String, String ]
  def self.limited: (String text, Hash[String, String?] values, Integer limit, String suffix) -> String

  public

  def initialize: (title: String, description: String, h1: String, seo_text: String?) -> void
end
