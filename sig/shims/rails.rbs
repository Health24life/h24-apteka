# The collected railties signatures lack the error reporter accessor; declare only what the app calls.
module Rails
  interface _ErrorReporter
    def report: (Exception error, handled: bool, ?context: Hash[Symbol, String | Symbol | Integer]) -> void
    def handle: [T] (?context: Hash[Symbol, String | Symbol | Integer]) { () -> T } -> T?
  end

  def self.error: () -> _ErrorReporter
end
