# The collected activerecord signatures type the class-level query methods only for the generated model classes
# (rbs_rails extends each with ClassMethods). A concern or a base class works with any model, so the base gets the same
# methods with the model, the relation and the key left open.
class ActiveRecord::Base
  extend ActiveRecord::Base::ClassMethods[untyped, untyped, untyped]
end

class ActiveRecord::ReadonlyAttributeError < ActiveRecord::ActiveRecordError
end

# Ransack adds these to every model.
class ActiveRecord::Base
  def self.authorizable_ransackable_attributes: () -> Array[String]
  def self.authorizable_ransackable_associations: () -> Array[String]
end

# Without a block, `in_batches` returns the batches themselves; the collected signatures declare only the block form.
module ActiveRecord
  interface _Batches
    def delete_all: () -> Integer
  end

  class Relation
    module Methods[Model, PrimaryKey]
      def in_batches: (?of: Integer, ?start: Integer, ?finish: Integer, ?load: bool, ?error_on_ignore: bool,
                       ?order: untyped) -> _Batches
                    | ...
    end
  end
end
