# ransack ships no signatures; declare only what the app touches.
module Ransack
  module Adapters
    module ActiveRecord
      module Base
        def authorizable_ransackable_attributes: () -> Array[String]

        def authorizable_ransackable_associations: () -> Array[String]
      end
    end
  end
end

class ActiveRecord::Base
  extend Ransack::Adapters::ActiveRecord::Base
end
